// Despliegue en Cloudflare Workers con activos estáticos (addendum A1 en ESTADO_SITIO.md).
// El sitio de la Etapa 1 es puramente estático: no hay campo "main" porque no existe
// código de Worker. La ruta bajo demanda de la fase 2 lo añadirá entonces, no antes.
{
  "name": "calcinst-web",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist/",
  },
  // Explícitos a propósito (DECISIONES_SITIO.md, AD3; ESTADO_SITIO.md, P3).
  // Las URL de preview se sirven en el subdominio workers.dev y no existen sin él:
  // con workers_dev en false, preview_urls: true no genera ninguna (PR #4, E3-g).
  // Costo aceptado: producción también responde en calcinst-web.instcalc.workers.dev.
  // Mitigación obligatoria antes de retirar el noindex global en la Etapa 9: ver P4.
  // El archivo de wrangler prevalece sobre el dashboard en cada despliegue.
  "workers_dev": true,
  "preview_urls": true,
  // Dominio canónico (D2). Los Custom Domains crean su propio registro DNS y no
  // requieren zone_id ni zone_name. Aquí solo va el canónico: `www.calcinst.mx`,
  // `calcinst.com` y `www.calcinst.com` NO sirven el sitio, redirigen con 301
  // mediante Redirect Rules a nivel de zone (ver ESTADO_SITIO.md, E1-l).
  "routes": [
    {
      "pattern": "calcinst.mx",
      "custom_domain": true,
    },
  ],
}
