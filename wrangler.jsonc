// Despliegue en Cloudflare Workers con activos estáticos (addendum A1 en ESTADO_SITIO.md).
// El sitio de la Etapa 1 es puramente estático: no hay campo "main" porque no existe
// código de Worker. La ruta bajo demanda de la fase 2 lo añadirá entonces, no antes.
{
  "name": "calcinst-web",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist/",
  },
  // Explícitos a propósito (ESTADO_SITIO.md, P3). Tras declarar `routes`, los PR
  // dejaron de recibir URL de preview y `calcinst-web.instcalc.workers.dev` pasó a
  // 404. La documentación dice que ninguno de los dos cambia por declarar rutas, así
  // que no se confía en el valor por omisión: el archivo de wrangler prevalece sobre
  // el dashboard en cada despliegue.
  //   workers_dev: false — producción NO se sirve en workers.dev (evita un host
  //                        duplicado del canónico; es además el estado ya observado).
  //   preview_urls: true — NO basta por sí solo: comprobado en el PR #4, con
  //                        workers_dev en false no se genera URL de preview (la de la
  //                        versión devuelve 404). Las previews viven en workers.dev.
  //                        Activarlas exige workers_dev: true; decisión pendiente (P3).
  "workers_dev": false,
  "preview_urls": true,
  // Dominio canónico (D2). Los Custom Domains crean su propio registro DNS y no
  // requieren zone_id ni zone_name. Aquí solo va el canónico: `www.calcinst.mx`,
  // `calcinst.com` y `www.calcinst.com` NO sirven el sitio, redirigen con 301
  // mediante Redirect Rules a nivel de zone (ver ESTADO_SITIO.md, E1-l).
  "routes": [
    {
      "pattern": "calcinst.mx",
      "custom_domain": true,
    },
  ],
}
