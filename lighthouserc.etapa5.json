{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/producto/",
        "http://localhost/blog/110-14c-decide-la-columna-no-el-conductor/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 3,
          "mobile": true,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "pessimistic" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.01, "aggregationMethod": "pessimistic" }
        ],
        "total-byte-weight": [
          "error",
          { "maxNumericValue": 600000, "aggregationMethod": "pessimistic" }
        ]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "evidencia/etapa-5-rendimiento/final" }
  }
}
