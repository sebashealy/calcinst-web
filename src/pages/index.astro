---
import LayoutBase from '../layouts/LayoutBase.astro'
import Boton from '../components/Boton.astro'
import Insignia from '../components/Insignia.astro'
import CapturaProducto from '../components/CapturaProducto.astro'
import CapacidadesProducto from '../components/CapacidadesProducto.astro'
import { TEXTO_VIGENTE, DESTINO_ACCION } from '../config/lanzamiento'
import '../styles/producto.css'
---

<LayoutBase
  titulo="CalcInst"
  descripcion="Traza instalaciones de motores trifásicos, revisa sus recorridos y reúne los resultados en CalcInst."
  noindex
>
  <div class="pagina-producto">
    <header class="hero" data-hero>
      <p class="sobretitulo">CalcInst / Herramienta de apoyo al cálculo</p>
      <Insignia tono={TEXTO_VIGENTE.insignia.tono}>{TEXTO_VIGENTE.insignia.texto}</Insignia>
      <h1>Tu instalación,<br />trazo por trazo.</h1>
      <p class="introduccion">
        Dibuja el recorrido de tus motores trifásicos. Revisa longitudes, factores y resultados en
        un mismo proyecto.
      </p>
      <p class="alcance">
        Alcance de la v1.0: motores trifásicos de inducción, de servicio continuo y con conductores
        de cobre.
      </p>
      <div class="acciones">
        <Boton href={DESTINO_ACCION}>{TEXTO_VIGENTE.accion}</Boton><Boton
          href="/producto/"
          variante="secundario">Explorar el producto</Boton
        >
      </div>
    </header>
    <CapturaProducto prioritaria />
    <CapacidadesProducto />
    <section class="cierre" aria-labelledby="blog-titulo">
      <p class="sobretitulo">Criterio técnico, paso a paso</p>
      <h2 id="blog-titulo">Entiende la norma detrás del cálculo</h2>
      <p>Artículos con referencias, supuestos y explicaciones para revisar tus decisiones.</p>
      <Boton href="/blog/" variante="secundario">Consultar los artículos</Boton>
    </section>
  </div>
</LayoutBase>
